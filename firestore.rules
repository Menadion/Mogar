rules_version = '2';

// Who can see what in Mogar. Paste into Firebase console > Firestore Database > Rules > Publish.
//
//   families/{code}                  anyone signed in can check a code exists (to join) or make a new one;
//                                    its creator renames it, hands it on, or deletes it as the last to leave
//   families/{code}/members/{uid}    only members of that family can read it; you can only write your own
//   feedback/{id}                    anyone signed in can add one; nobody can read them from a phone
//   probes/{uid}                     one phone's own settings-page report; nobody can read them from a phone
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(code) {
      return exists(/databases/$(database)/documents/families/$(code)/members/$(request.auth.uid));
    }

    match /families/{code} {
      // "get" is one family by its code. Listing every family is not allowed.
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // Only whoever made the family can change its name, or hand the family on to another member
      // when leaving. Nothing else about it changes.
      allow update: if signedIn() && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'createdBy'])
        && exists(/databases/$(database)/documents/families/$(code)/members/$(request.resource.data.createdBy));
      // The last one to leave is always the creator (it's handed on), and takes the family with them.
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn() && isMember(code);
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/families/$(code));
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Notes from Settings > Send feedback. A phone can add its own, and no phone can read any.
    // They're read on the laptop by tools/read-feedback.mjs, whose admin key skips these rules.
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // What the brand's settings pages are actually called on this phone, so a button that goes
    // nowhere can be fixed from the laptop without the phone in hand. One doc per phone, named
    // after its own uid, so a later report replaces the old one instead of piling up.
    // No phone reads any of them; tools/read-phones.mjs does, with the admin key.
    // Delete is allowed so that answering "no" can withdraw this phone's own report, the same way
    // it clears the diagnostics on its member document. A phone can only ever touch its own.
    match /probes/{uid} {
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
